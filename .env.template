# YouSim runs on your own machine with your own model credentials.
# Only PROVIDER plus the matching API key is required.

# LLM Provider: anthropic, openrouter, openai, groq
PROVIDER=anthropic

# API Keys (only the one matching your PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Model override. Note that the simulator effect depends heavily on the model:
# older, less instruction-tuned models produce far more interesting output than
# current frontier assistants.
MODEL=

# Point at any OpenAI-compatible endpoint (local vLLM, Ollama, a gateway).
# Used when PROVIDER=openai.
OPENAI_BASE_URL=

# Optional if the frontend and API are on different origins
VITE_API_URL=

# Local server port
PORT=3000
