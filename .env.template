# YouSim runs on your own machine with your own model credentials.
#
# The easiest setup is no .env at all:
#
#   yousim connect     # links an OpenRouter account via OAuth, nothing to paste
#   yousim             # go
#
# Everything below is for overriding that. Note that env vars WIN over a
# connected account, so a stale value here will silently override `connect`.

# ─── Provider ────────────────────────────────────────────────────────────────
# anthropic | openrouter | openai | groq
PROVIDER=openrouter

# ─── Credentials ─────────────────────────────────────────────────────────────
# Only the one matching PROVIDER is used. `yousim connect` covers OpenRouter,
# so you can leave these empty.
#
# These are NOT interchangeable: OPENAI_API_KEY will not authenticate
# OpenRouter. Each provider reads only its own variable.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ─── Model ───────────────────────────────────────────────────────────────────
# Model choice dominates output quality here. Older, less instruction-tuned
# models produce far more interesting simulations than current frontier
# assistants, which are trained out of exactly the loose associative
# generation that makes this work.
#
# CAUTION: MODEL applies to EVERY provider, and model ids are provider-specific.
# Setting it for a local endpoint and then switching providers sends a name the
# new provider has never heard of. Leave it unset unless you mean it.
#
#   openrouter   meta-llama/llama-3.3-70b-instruct   (default; "vendor/model")
#                nousresearch/hermes-3-llama-3.1-70b
#                gryphe/mythomax-l2-13b
#   anthropic    claude-sonnet-4-5-20250929
#   openai       gpt-4o
#   groq         llama-3.3-70b-versatile
#
# OpenRouter retires models: anthropic/claude-3.5-sonnet used to work and now
# 404s. If you get "No endpoints found", the id is dead — check
# https://openrouter.ai/models
MODEL=

# Applies only when PROVIDER=openrouter, and MODEL overrides it.
OPENROUTER_MODEL=

# ─── Local / self-hosted endpoints ───────────────────────────────────────────
# Point at any OpenAI-compatible server (vLLM, Ollama, a gateway).
# Used only when PROVIDER=openai. Most such servers want a non-empty
# OPENAI_API_KEY even though they ignore it.
#
#   PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:8000/v1/
#   OPENAI_API_KEY=placeholder
#   MODEL=<whatever your server calls it>
OPENAI_BASE_URL=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Conversations persist here and survive restarts. Defaults to
# ~/.yousim/yousim.db, or $XDG_DATA_HOME/yousim/ when that is set.
YOUSIM_DB=

# ─── Local server ────────────────────────────────────────────────────────────
PORT=3000
# Only needed if the frontend and API are served from different origins.
VITE_API_URL=
