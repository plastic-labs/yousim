# LLM Provider options include anthropic or openrouter
PROVIDER=anthropic
# Generic model override (recommended)
MODEL=claude-sonnet-4-5-20250929
# OpenRouter-specific model (optional)
OPENROUTER_MODEL=

# Anthropic API Key
ANTHROPIC_API_KEY=
# OpenAI API Key used for OpenRouter
OPENAI_API_KEY=
# OpenRouter API Key (alternative to OPENAI_API_KEY)
OPENROUTER_API_KEY=

# Supabase (API)
SUPABASE_URL=
SUPABASE_KEY=
# Supabase JWT verification (asymmetric keys)
# Optional overrides for local dev or custom setups
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=

# Frontend (Vite build-time)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# Optional if frontend and API are on different origins
VITE_API_URL=

# Server
PORT=3000

# Legacy (python/webshell) optional
HONCHO_ENV=https://demo.honcho.dev
HONCHO_APP_NAME=
# Regex for the url the legacy webshell will be running on
CLIENT_REGEX=http://localhost:5173(\/share)?
# Fernet secret key for encrypting share urls (legacy)
SECRET_KEY=
