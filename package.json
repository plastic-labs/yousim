{
  "name": "yousim-monorepo",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "description": "YouSim - Identity simulation in the latent space",
  "workspaces": [
    "src/*"
  ],
  "private": true,
  "scripts": {
    "dev": "bun run --filter '@yousim/api' dev & bun run --filter '@yousim/web' dev",
    "dev:api": "bun run --filter '@yousim/api' dev",
    "dev:web": "bun run --filter '@yousim/web' dev",
    "build": "bun run --filter '@yousim/web' build",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun run scripts/hermetic.ts",
    "test:live": "bun run scripts/hermetic.ts --live",
    "pack": "bun run scripts/package.ts",
    "test:ci": "bun run typecheck && bun run pack && bun run scripts/hermetic.ts --coverage",
    "start:api": "bun run --filter '@yousim/api' start",
    "start:cli": "bun run src/cli/src/cli.ts"
  },
  "dependencies": {
    "elysia": "^1.4.25"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
