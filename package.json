{
  "name": "yousim",
  "version": "1.0.0",
  "description": "YouSim - Identity simulation in the latent space",
  "workspaces": [
    "src/*"
  ],
  "private": true,
  "scripts": {
    "dev": "bun run --filter '@yousim/api' dev & bun run --filter '@yousim/frontend' dev",
    "dev:api": "bun run --filter '@yousim/api' dev",
    "dev:frontend": "bun run --filter '@yousim/frontend' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "start:api": "bun run --filter '@yousim/api' start",
    "start:cli": "bun run --filter '@yousim/cli' start"
  }
}