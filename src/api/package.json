{
  "name": "@yousim/api",
  "version": "0.1.0",
  "description": "Local YouSim server: Elysia + SQLite, no auth",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
