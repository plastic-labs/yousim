    "access": "public"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/static": "^1.4.4",
    "@yousim/core": "workspace:*",
    "elysia": "^1.4.13"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
