#!/bin/sh
# Pick a runtime, then hand over.
#
# A shebang names one interpreter, and this package supports two. `#!/usr/bin/env
# node` breaks a machine that has only Bun; `#!/usr/bin/env bun` breaks a machine
# that has only Node. There is no third spelling that means "either".
#
# It matters because both package managers copy this shebang into the shim they
# generate for a global install. `bun add -g yousim` on a machine without Node
# produced a `yousim` that died with `env: node: No such file or directory` —
# before any of our code ran, so nothing could explain it. `bunx yousim` and
# `bun run yousim` were fine, because Bun executes the bundle itself rather than
# consulting the shebang; only the bare command was broken. That bare command is
# the thing a global install exists to provide.
#
# So: /bin/sh, which is present on every POSIX machine either runtime runs on,
# and one exec. The cost is a process per launch. On Windows npm generates its
# own .cmd shim from this shebang and needs an `sh` on PATH (Git Bash, WSL) —
# CI's windows-latest job is what checks that, not an assumption written here.

set -e

# Resolve through symlinks: both npm and bun link this into their bin directory,
# so $0 is usually a link and dirname $0 is the link's home, not the package's.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
bundle="$dir/../dist/yousim.js"

if command -v bun >/dev/null 2>&1; then
  # --no-env-file and --config=/dev/null are the DEV-2619 security control, not
  # style: without them Bun autoloads ./.env and ./bunfig.toml from whatever
  # directory the user happens to be in, and a bunfig `preload` runs arbitrary
  # code before this package's first line. They live here now rather than in a
  # shebang, which is a straight improvement — `env -S` was never portable.
  exec bun --no-env-file --config=/dev/null "$bundle" "$@"
fi

# Node needs no equivalent flags: it does not autoload .env and has no bunfig.
exec node "$bundle" "$@"
